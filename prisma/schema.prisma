generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model MediaJob {
  id         String   @id @default(uuid())
  source     String   // 'n8n' | 'manual'
  prompt     String
  status     String   // 'pending', 'audio_ready', 'video_ready', 'sent', 'error'
  audioUrl   String?
  videoUrl   String?
  imageUrl   String?
  recipient  String?
  errorLog   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
